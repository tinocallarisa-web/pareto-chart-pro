{
    "dataRoles": [
        {
            "displayName": "Entity",
            "displayNameKey": "Role_category",
            "name": "category",
            "kind": "Grouping",
            "description": "Category field to rank (customer, product, SKU…)"
        },
        {
            "displayName": "Value",
            "displayNameKey": "Role_measure",
            "name": "measure",
            "kind": "Measure",
            "description": "Numeric measure to concentrate (sales, revenue, liters…)"
        },
        {
            "displayName": "Comparison value (Pro)",
            "displayNameKey": "Role_comparison",
            "name": "comparison",
            "kind": "Measure",
            "description": "A second measure to compare with, e.g. last year's sales. Each period is ranked on its own."
        },
        {
            "displayName": "Small multiples (Pro)",
            "displayNameKey": "Role_panel",
            "name": "panel",
            "kind": "Grouping",
            "description": "One Pareto per value of this field: plant, region, product line."
        },
        {
            "displayName": "Tooltips",
            "displayNameKey": "Role_tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Additional measures to display in tooltips"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "measure": {
                        "max": 1
                    },
                    "comparison": {
                        "max": 1
                    },
                    "panel": {
                        "max": 1
                    },
                    "tooltips": {
                        "max": 10
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "category"
                            }
                        },
                        {
                            "bind": {
                                "to": "panel"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "measure"
                            }
                        },
                        {
                            "bind": {
                                "to": "comparison"
                            }
                        },
                        {
                            "bind": {
                                "to": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "general": {
            "displayName": "General",
            "displayNameKey": "Obj_general",
            "properties": {
                "filter": {
                    "type": {
                        "filter": true
                    }
                }
            }
        },
        "pareto": {
            "displayName": "Pareto",
            "displayNameKey": "Obj_pareto",
            "properties": {
                "binSizePct": {
                    "displayName": "Bin size % of entities (Pro)",
                    "displayNameKey": "Prop_pareto_binSizePct",
                    "description": "Each bar represents this % of entities. Free tier fixed at 20% (5 bins). Pro: 1–20%.",
                    "type": {
                        "numeric": true
                    }
                },
                "trimLower": {
                    "displayName": "Exclude bottom % entities (Pro)",
                    "displayNameKey": "Prop_pareto_trimLower",
                    "description": "Remove the bottom N% of entities (outliers) before calculating bins.",
                    "type": {
                        "numeric": true
                    }
                },
                "trimUpper": {
                    "displayName": "Exclude top % entities (Pro)",
                    "displayNameKey": "Prop_pareto_trimUpper",
                    "description": "Remove the top N% of entities (outliers) before calculating bins.",
                    "type": {
                        "numeric": true
                    }
                },
                "barColor": {
                    "displayName": "Bar color",
                    "displayNameKey": "Prop_pareto_barColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    },
                    "description": "Fill color for all bars. Supports rule-based conditional formatting (fx): each bar takes the resolved color of its top-ranked entity.",
                    "rule": {
                        "inputRole": "measure",
                        "output": {
                            "property": "barColor",
                            "selector": [
                                "category"
                            ]
                        }
                    }
                },
                "barOpacity": {
                    "displayName": "Bar opacity %",
                    "displayNameKey": "Prop_pareto_barOpacity",
                    "type": {
                        "numeric": true
                    }
                },
                "borderColor": {
                    "displayName": "Border color",
                    "displayNameKey": "Prop_pareto_borderColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderWidth": {
                    "displayName": "Border width",
                    "displayNameKey": "Prop_pareto_borderWidth",
                    "type": {
                        "numeric": true
                    }
                },
                "barGap": {
                    "displayName": "Bar gap px",
                    "displayNameKey": "Prop_pareto_barGap",
                    "type": {
                        "numeric": true
                    }
                },
                "ibcsMode": {
                    "displayName": "IBCS Mode (Standardized)",
                    "displayNameKey": "Prop_pareto_ibcsMode",
                    "description": "Apply International Business Communication Standards styling (neutral colors, clean contrast, standardized IBCS palette)",
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "thresholdColors": {
            "displayName": "Threshold Colors",
            "displayNameKey": "Obj_thresholdColors",
            "description": "Color bins by where they fall relative to a cumulative % threshold.",
            "properties": {
                "show": {
                    "displayName": "Color bars by threshold",
                    "displayNameKey": "Prop_thresholdColors_show",
                    "description": "Overrides Bar color. Bins are colored by whether their cumulative % is within the threshold.",
                    "type": {
                        "bool": true
                    }
                },
                "thresholdValue": {
                    "displayName": "Threshold (cumulative %)",
                    "displayNameKey": "Prop_thresholdColors_thresholdValue",
                    "description": "Cumulative percentage that separates the vital few from the trivial many. Defaults to 80.",
                    "type": {
                        "numeric": true
                    }
                },
                "withinColor": {
                    "displayName": "Within threshold",
                    "displayNameKey": "Prop_thresholdColors_withinColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "beyondColor": {
                    "displayName": "Beyond threshold",
                    "displayNameKey": "Prop_thresholdColors_beyondColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "highlightCrossing": {
                    "displayName": "Highlight crossing bin",
                    "displayNameKey": "Prop_thresholdColors_highlightCrossing",
                    "description": "Emphasize the bin in which the cumulative line crosses the threshold.",
                    "type": {
                        "bool": true
                    }
                },
                "crossingColor": {
                    "displayName": "Crossing bin color",
                    "displayNameKey": "Prop_thresholdColors_crossingColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
